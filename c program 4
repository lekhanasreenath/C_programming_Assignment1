/* Cab Fare Calculation - C Programming Assignment 01 */
#include <stdio.h>
#include <string.h>

int main(void) {
    double distance, fare = 100.0;
    char member[10];

    scanf("%lf", &distance);
    scanf("%9s", member); /* Accept true/false or 1/0 */

    if (distance > 10.0) {
        fare += (distance - 10.0) * 20.0;
    }

    if (strcmp(member, "true") == 0 || strcmp(member, "TRUE") == 0 ||
        strcmp(member, "1") == 0) {
        fare *= 0.90;
    }

    printf("Final Fare: ₹%.0f\n", fare);
    return 0;
}
