/* Employee Job Level - C Programming Assignment 01 */
#include <stdio.h>

int main(void) {
    int experience, performance;

    scanf("%d%d", &experience, &performance);

    if (experience < 3) {
        printf("Level: Junior\n");
    } else if (experience <= 7) {
        if (performance >= 80) {
            printf("Level: Mid-Level\n");
        } else {
            printf("Level: Junior\n");
        }
    } else {
        if (performance >= 85) {
            printf("Level: Senior\n");
        } else {
            printf("Level: Mid-Level\n");
        }
    }

    return 0;
}
